@article{anthi2024rf,
  title = {Investigating Radio Frequency Vulnerabilities in the Internet of Things (IoT)},
  author = {Eirini Anthi and Lowri Williams and Vasilis Ieropoulos and Theodoros Spyridopoulos},
  journal = {IoT},
  volume = {5},
  number = {2},
  pages = {356--380},
  year = {2024},
  doi = {10.3390/iot5020017},
  abstract = {This paper investigates radio frequency (RF) vulnerabilities in IoT devices, demonstrating practical attacks including jamming, replay, and spoofing across common IoT protocols. We evaluate the effectiveness of low-cost software-defined radio platforms for both attack and defence.},
  keywords = {IoT, radio frequency, jamming, spoofing, software-defined radio}
}

@article{ieropoulos2025collaborative,
  title = {Collaborative Intrusion Detection in Resource-Constrained IoT Environments: Challenges, Methods, and Future Directions},
  author = {Vasilis Ieropoulos and Eirini Anthi and Theodoros Spyridopoulos and Pete Burnap and Ioannis Mavromatis and Aftab Khan},
  journal = {Journal of Information Security and Applications},
  volume = {93},
  pages = {104127},
  year = {2025},
  doi = {10.1016/j.jisa.2025.104127},
  abstract = {A comprehensive review of collaborative intrusion detection approaches for resource-constrained IoT environments. We analyse federated learning, distributed detection, and edge-based architectures, identifying key challenges in communication efficiency, model accuracy, and privacy preservation.},
  keywords = {intrusion detection, IoT, federated learning, edge computing, resource-constrained devices}
}

@inproceedings{ieropoulos2024gps,
