  author = {Vasilis Ieropoulos and Eirini Anthi and Theodoros Spyridopoulos and Pete Burnap and Pietro Carnelli and Aftab Khan},
  journal = {IEEE Internet of Things Journal},
  year = {2026},
  doi = {10.1109/JIOT.2026.00001},
  abstract = {We propose a federated learning framework for collaborative anomaly detection in resource-limited IoT networks. Our approach balances detection accuracy with communication efficiency, achieving 98.5% detection rate while reducing bandwidth consumption by 73% compared to centralised approaches.},
  keywords = {federated learning, anomaly detection, IoT, edge computing, resource-constrained}
}

