@inproceedings{ieropoulos2024securing,
  title = {Securing Industrial Control Systems via Moving Target Defense in Software-Defined Networks},
  author = {Vasilis Ieropoulos and Dimitris Papadopoulos and Elena Karamanou},
  booktitle = {Proceedings of the 2024 IEEE Symposium on Security and Privacy (SP)},
  year = {2024},
  doi = {10.1109/SP.2024.00001},
  abstract = {We present a moving target defense framework for ICS environments that leverages SDN capabilities to dynamically reconfigure network topologies, confounding adversary reconnaissance and lateral movement. Evaluated on the PowerRanger testbed.},
  keywords = {ICS security, moving target defense, software-defined networking, industrial control systems}
}

@article{karamanou2023deep,
  title = {Deep Learning-Based Anomaly Detection for Industrial IoT: A Comparative Evaluation},
  author = {Elena Karamanou and Vasilis Ieropoulos},
  journal = {IEEE Transactions on Industrial Informatics},
  volume = {19},
  number = {8},
  pages = {8912--8923},
  year = {2023},
  doi = {10.1109/TII.2023.3240001},
  abstract = {A comprehensive evaluation of deep learning architectures (CNNs, LSTMs, Transformers) for anomaly detection in IIoT time-series data. We propose a hybrid CNN-Transformer model achieving 99.2% detection rate on the SWaT dataset.},
  keywords = {deep learning, anomaly detection, industrial IoT, time-series analysis}
}

@inproceedings{papadopoulos2023sdn,
  title = {SDN-Enabled Intrusion-Tolerant Control for Smart Grid Wide-Area Monitoring},
  author = {Dimitris Papadopoulos and Vasilis Ieropoulos},
  booktitle = {Proceedings of the 2023 ACM Conference on Data and Application Security and Privacy (CODASPY)},
  year = {2023},
  doi = {10.1145/3575879.3576012},
  abstract = {We propose an intrusion-tolerant control architecture for smart grid WAMS that uses SDN-based redundancy management to maintain stability during cyber attacks. Demonstrated on a real-time hardware-in-the-loop simulation.},
  keywords = {smart grid, wide-area monitoring, intrusion tolerance, SDN}
}

@inproceedings{mavridou2023tee,
  title = {SoK: Trusted Execution Environments for Embedded Cyber-Physical Systems},
  author = {Sophia Mavridou and Vasilis Ieropoulos},
  booktitle = {Proceedings of the 2023 IEEE European Symposium on Security and Privacy (EuroS&P)},
  year = {2023},
  doi = {10.1109/EuroSP.2023.00012},
  abstract = {A systematization of knowledge on TEE architectures for resource-constrained CPS devices. We evaluate ARM TrustZone-M, RISC-V Keystone, and Intel SGX for ICS workloads, identifying security gaps and performance trade-offs.},
  keywords = {trusted execution, embedded systems, systematization of knowledge, ARM TrustZone}
}

@article{ieropoulos2023formal,
  title = {Formal Verification of Safety-Critical Cyber-Physical Systems: A Survey},
  author = {Vasilis Ieropoulos},
  journal = {ACM Computing Surveys},
  volume = {56},
  number = {4},
  pages = {1--38},
  year = {2024},
  doi = {10.1145/3617653},
  abstract = {A comprehensive survey of formal methods applied to CPS security verification, covering model checking, theorem proving, and runtime verification across power systems, automotive, and industrial control domains.},
  keywords = {formal verification, cyber-physical systems, model checking, safety-critical systems}
}

@inproceedings{antoniou2024honeypot,
  title = {HoneyPLC: A High-Interaction PLC Honeypot for Industrial Control Systems},
  author = {Georgios Antoniou and Elena Karamanou and Vasilis Ieropoulos},
  booktitle = {Proceedings of the 2024 NDSS Workshop on OT Security (NDSS-OT)},
  year = {2024},
  doi = {10.14722/ndss-ot.2024.00001},
  abstract = {We present HoneyPLC, a high-interaction honeypot that emulates real Programmable Logic Controller behavior, supporting multiple vendor protocols. Deployed across 12 countries, we analyze attacker TTPs targeting OT infrastructure.},
  keywords = {honeypot, PLC, industrial control systems, threat intelligence}
}

@article{karamanou2024maritime,
  title = {Cyber-Physical Security of Maritime Systems: Threats, Vulnerabilities, and Countermeasures},
  author = {Elena Karamanou},
  journal = {IEEE Communications Surveys \& Tutorials},
  year = {2024},
  note = {Under Review},
  abstract = {A comprehensive survey of cyber-physical security challenges in maritime systems, including navigation, propulsion, and cargo management systems. We identify critical vulnerabilities and propose a defense-in-depth framework.},
  keywords = {maritime security, cyber-physical systems, survey, defense-in-depth}
}

@inproceedings{ieropoulos2022powerranger,
  title = {PowerRanger: A Cyber Range for the Smart Grid},
  author = {Vasilis Ieropoulos and Dimitris Papadopoulos and Nikos Petrovas},
  booktitle = {Proceedings of the 2022 ACM Workshop on Cyber-Physical Systems Security (CPSS)},
  year = {2022},
  doi = {10.1145/3494109.3527190},
  abstract = {We present PowerRanger, an open-source cyber range platform for smart grid security research. The platform integrates hardware-in-the-loop simulation with real IEC 61850 communications for realistic attack-defense scenarios.},
  keywords = {cyber range, smart grid, hardware-in-the-loop, IEC 61850}
}

@article{petrovas2022hil,
  title = {Hardware-in-the-Loop Testbeds for Smart Grid Cybersecurity: A Design Methodology},
  author = {Nikos Petrovas and Vasilis Ieropoulos},
  journal = {International Journal of Critical Infrastructure Protection},
  volume = {38},
  pages = {100530},
  year = {2022},
  doi = {10.1016/j.ijcip.2022.100530},
  abstract = {A design methodology for hardware-in-the-loop testbeds applied to smart grid cybersecurity research. We detail the integration of real protection relays, PMUs, and RTDS simulators.},
  keywords = {hardware-in-the-loop, testbed design, smart grid, critical infrastructure}
}
