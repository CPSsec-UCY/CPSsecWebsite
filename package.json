    "bibtex-parse": "^2.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "nanoid": "^3.3.20",
    "node": "^24.22.3",
    "postcss": "^8.5.33",
    "source-map-js": "^1.2.4",
